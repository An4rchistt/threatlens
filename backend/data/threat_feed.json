  "patterns": [
    {
      "id": "brand_dash_secure_login",
      "regex": "\\b(paypal|apple|microsoft|amazon|netflix|coinbase|binance|metamask|instagram|facebook|google|outlook|office365)[-.](secure|login|signin|sign-in|verify|verification|account|update|support|billing|alert|unlock|confirm|recovery|security)\\b",
      "category": "phishing",
      "note": "Brand name adjacent to a security/action word in the registrable label - the dominant phishing-domain morphology."
    },
    {
      "id": "wallet_seed_recovery_host",
      "regex": "\\b(wallet|seed|recovery|restore|validate|airdrop|claim)[-.]?(connect|verify|sync|phrase|metamask|ledger|trezor)\\b",
      "category": "phishing",
      "note": "Crypto wallet-drainer host morphology."
    },
    {
      "id": "parcel_fee_scam_host",
      "regex": "\\b(usps|dhl|fedex|ups|royalmail|dpd|correos)[-.]?(redelivery|customs|parcel|tracking|fee|package|delivery)[-.]?(pay|fee|update|confirm)?\\b",
      "category": "scam",
      "note": "Parcel-fee / redelivery smishing host morphology."
    }
  ]
