# ---------------------------------------------------------------------------
# ThreatLens environment template.  Copy to `.env` and fill in your keys:
#   cp .env.example .env
# `.env` is git-ignored; never commit real credentials.
# ---------------------------------------------------------------------------

# --- AI engine (any OpenAI-compatible provider) ----------------------------
# Pick one provider and set only its key. Leave AI_PROVIDER empty to
# auto-detect from whichever key below has a value.
#
#   groq       Free, no credit card, fastest. Key: https://console.groq.com/keys
#              Default model: openai/gpt-oss-20b
#   gemini     Free via AI Studio.           Key: https://aistudio.google.com/apikey
#              Default model: gemini-3.6-flash (2.5-flash is refused for new keys)
#   openrouter Rotating ':free' models.      Key: https://openrouter.ai/keys
#   ollama     Fully local, no key at all. Needs the optional ollama service.
#   openai     Paid; requires a funded balance.
#
# Leaving every key empty is supported: the platform runs on its deterministic
# heuristic engine plus VirusTotal and reports the AI engine as off.
AI_PROVIDER=groq
AI_MODEL=
AI_TIMEOUT_SECONDS=45
# Reasoning models spend output tokens thinking before they emit any content, so
# a tight budget returns an empty completion rather than a short one.
AI_MAX_TOKENS=4096
# Optional thinking budget: low | medium | high. Empty lets the model decide.
AI_REASONING_EFFORT=

GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Only needed for AI_PROVIDER=custom or a self-hosted endpoint.
AI_BASE_URL=
AI_API_KEY=
# Force JSON mode on/off. Unset means "use the provider default"; the analyzer
# retries without it automatically if the provider rejects the parameter.
AI_JSON_MODE=

# --- Threat intelligence (VirusTotal v3) ----------------------------------
# Free community keys allow ~4 requests/minute and ~500/day.
# Get one at https://www.virustotal.com/gui/my-apikey
# Leave empty to run without threat intel; the other engines still work.
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_TIMEOUT_SECONDS=15

# --- Postgres --------------------------------------------------------------
POSTGRES_USER=threatlens
POSTGRES_PASSWORD=threatlens_dev_password
POSTGRES_DB=threatlens
# Consumed directly by the backend container; docker compose builds the same
# value from the three variables above.
DATABASE_URL=postgresql+psycopg2://threatlens:threatlens_dev_password@postgres:5432/threatlens

# --- API hardening ---------------------------------------------------------
# Shared secret for /api/scan, /api/scans and /api/scans/{id}. Callers must send
#   X-API-Key: <value>
# /api/health and /api/config stay open (container healthcheck + UI bootstrap).
# Empty means those endpoints are UNAUTHENTICATED - localhost development only.
# Changing this value requires `docker compose build frontend` as well, because
# it is baked into the browser bundle as NEXT_PUBLIC_API_KEY at build time.
# Anything in a browser bundle is readable by the user: this protects against
# other machines and bots, not against the person using the dashboard. For a
# public deployment, proxy /api/* through a server-side route instead.
# Generate one with:
#   python -c "import secrets; print('tl_' + secrets.token_urlsafe(32))"
API_KEY=
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
ENABLE_DOCS=1
LOG_LEVEL=INFO

# --- Sandboxed scraper -----------------------------------------------------
SCRAPER_NAV_TIMEOUT_MS=10000
SCRAPER_TOTAL_TIMEOUT_SECONDS=30
SCRAPER_MAX_SCREENSHOT_BYTES=3500000
SCRAPER_NO_SANDBOX=1
MAX_CONCURRENT_SCANS=2

# --- Ports / frontend ------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
